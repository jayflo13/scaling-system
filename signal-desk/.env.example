# Copy to .env (gitignored). Never commit real keys.

# Anthropic API key used by the `claude` CLI the orchestrator shells out to.
ANTHROPIC_API_KEY=

# --- Risk / cost guardrails -------------------------------------------------
# Hard daily spend ceiling in USD. The orchestrator stops before exceeding it.
DAILY_USD_CAP=5

# Universe of symbols the desk researches (comma-separated).
WATCHLIST=AAPL,MSFT,NVDA,SPY

# Max agent turns per specialist (loop backstop).
MAX_TURNS=12

# Logical MCP server names (must match your Claude Code MCP config).
IBKR_MCP=ibkr
GMAIL_MCP=gmail

# Where approved digests are drafted to (your own inbox is fine).
DIGEST_RECIPIENT=
