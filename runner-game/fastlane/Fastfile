default_platform(:android)

platform :android do
  desc "Upload the prebuilt AAB to Google Play (track: internal/alpha/beta/production)"
  lane :deploy do |options|
    track = options[:track] || "internal"
    upload_to_play_store(
      track: track,
      aab: "build/runner.aab",
      json_key: ENV["SUPPLY_JSON_KEY"],          # Play service-account JSON (CI secret)
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "draft"                     # promote manually until you trust the pipeline
    )
  end
end

